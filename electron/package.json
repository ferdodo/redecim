{
  "name": "redecim",
  "productName": "Redecim",
  "desktopName": "redecim.desktop",
  "version": "0.1.4",
  "description": "Batch video compressor",
  "homepage": "https://github.com/ferdodo/redecim",
  "author": {
    "name": "ferdodo",
    "email": "maintainer@example.org"
  },
  "main": "dist/main/main.cjs",
  "scripts": {
    "build": "tooling-suite exportcase biome typecheck test && npm run bundle && electron-builder",
    "bundle": "npm run bundle:main && npm run bundle:preload && npm run bundle:renderer",
    "bundle:main": "esbuild src/main/main.ts --bundle --platform=node --format=cjs --external:electron --external:ffmpeg-static --outfile=dist/main/main.cjs",
    "bundle:preload": "esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/preload.cjs",
    "bundle:renderer": "vite build --config vite.renderer.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "compressor": "../compressor",
    "core": "../core",
    "design-system": "../design-system",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "features": "../features",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tooling-suite": "^0.0.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
